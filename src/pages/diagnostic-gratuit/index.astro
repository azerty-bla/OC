      const userMsg = String(fd.get('message') ?? '');
      let meta = `\n\n--- Informations ---\nPage: ${location.href}\nDevice: ${device}\nReferrer: ${document.referrer || 'direct'}`;
      if (tracking) meta += `\nTemps sur site: ${tracking.timeOnSite}\nPages visitées (${tracking.pageCount}): ${tracking.visitedPages}`;
      const data = {
        raison_sociale: String(fd.get('raison_sociale') ?? ''),
        nom: String(fd.get('nom') ?? ''),
        email: String(fd.get('email') ?? ''),
        telephone: String(fd.get('telephone') ?? ''),
        message: (userMsg ? userMsg + meta : meta).slice(0, 5000),
        page_origine: location.href.slice(0, 300),
        site_origine: location.hostname,
      };

      if (btn) { btn.disabled = true; btn.textContent = 'Envoi en cours…'; }

      void fetch(`${STRAPI}/api/oteria-conseil-contacts`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${STRAPI_TOKEN}` },
        body: JSON.stringify({ data }),
      }).catch(() => {});

      void fetch('https://submitform-zxozovgrgq-od.a.run.app', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ collection: 'oteria-conseil-contact', data }),
      }).catch(() => {});

      try {
        const res = await fetch(`${SUPA_URL}/functions/v1/form-webhook`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${SUPA_KEY}` },
          // CRM : longueurs max (collage / autofill) ; sauvegardes Strapi / Firebase inchangées
          body: JSON.stringify({ collection: 'oteria-conseil-contacts', data: { ...data, raison_sociale: data.raison_sociale.trim().slice(0, 200), nom: data.nom.trim().slice(0, 100) } }),
        });
        if (!res.ok) throw new Error('Erreur serveur');
        const wrapper = form.closest('.bg-white') ?? form.parentElement;
        if (wrapper) wrapper.innerHTML = SUCCESS_HTML;
      } catch {
        if (btn) { btn.disabled = false; btn.textContent = 'Envoyer ma demande'; }
        let err = form.querySelector('.form-err');
        if (!err) {
          err = document.createElement('p');
          err.className = 'form-err';
          (err as HTMLElement).style.cssText = 'color:#e53e3e;font-size:0.8rem;margin-top:0.75rem;text-align:center;';
          form.appendChild(err);
        }
        err.textContent = 'Une erreur est survenue, veuillez réessayer.';
      }
    });
  })();
  </script>

