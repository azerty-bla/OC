      {code: "BAT-EQ-129", title: "Lanterneaux d'éclairage zénithal", description: "Lanterneaux d'éclairage zénithal (France métropolitaine).", version: "Version A26", pdf: "https://calculateur-cee.ademe.fr/pdf/display/194/BAT-EQ-129"},
