---
import "../../../../styles/global.css";
import ExpertisePage from "../../../../layouts/ExpertisePage.astro";
import FicheGrid from "../../../../components/FicheGrid.astro";

const journeyPages = [
  {label: "Vue d'ensemble", href: "/dispositifs/fiches-cee/"},
  {label: "Tertiaire", href: "/dispositifs/fiches-cee/tertiaire/"},
  {label: "Industrie", href: "/dispositifs/fiches-cee/industrie/"},
  {label: "Résidentiel", href: "/dispositifs/fiches-cee/residentiel/"},
  {label: "Agriculture", href: "/dispositifs/fiches-cee/agriculture/"},
  {label: "Transport", href: "/dispositifs/fiches-cee/transport/"},
];

const groups = [
  {
    title: "Enveloppe du bâtiment",
    fiches: [
      {code: "BAR-EN-101", title: "Isolation de combles ou de toitures", description: "Isolation thermique des combles ou des toitures d'un logement existant.", version: "Version A64-6, en vigueur depuis le 01/01/2025", pdf: "https://calculateur-cee.ademe.fr/pdf/display/286/BAR-EN-101", link: {href: "/expertises/isolation-thermique/residentiel/", label: "Isolation en copropriété"}},
      {code: "BAR-EN-102", title: "Isolation des murs", description: "Isolation thermique des murs d'un logement existant.", version: "Version A65-4, en vigueur depuis le 01/01/2025", pdf: "https://calculateur-cee.ademe.fr/pdf/display/324/BAR-EN-102", link: {href: "/expertises/isolation-thermique/exterieur/", label: "Isolation des murs par l'extérieur"}},
      {code: "BAR-EN-103", title: "Isolation d'un plancher", description: "Isolation thermique d'un plancher bas (cave, vide sanitaire, parking).", version: "Version A64-6, en vigueur depuis le 01/01/2025", pdf: "https://calculateur-cee.ademe.fr/pdf/display/289/BAR-EN-103", link: {href: "/expertises/isolation-thermique/planchers/", label: "Isolation des planchers bas"}},
      {code: "BAR-EN-104", title: "Fenêtre ou porte-fenêtre complète avec vitrage isolant", description: "Remplacement de fenêtres ou portes-fenêtres par des menuiseries à vitrage isolant.", version: "Version A54, en vigueur depuis le 01/01/2024", pdf: "https://calculateur-cee.ademe.fr/pdf/display/22/BAR-EN-104"},
      {code: "BAR-EN-105", title: "Isolation des toitures terrasses", description: "Isolation thermique des toitures terrasses.", version: "Version A64-4, en vigueur depuis le 01/01/2025", pdf: "https://calculateur-cee.ademe.fr/pdf/display/290/BAR-EN-105"},
    ],
  },
  {
    title: "Chauffage et eau chaude collectifs",
    fiches: [
      {code: "BAR-TH-179", title: "Pompe à chaleur collective de type air/eau", description: "Pompe à chaleur collective de type air/eau.", version: "Version A81, en vigueur depuis le 30/04/2026", pdf: "https://calculateur-cee.ademe.fr/pdf/display/280/BAR-TH-179", link: {href: "/expertises/pompe-a-chaleur/residentiel/", label: "Pompe à chaleur en copropriété"}},
      {code: "BAR-TH-180", title: "Pompe à chaleur collective de type eau/eau ou eau glycolée/eau", description: "Pompe à chaleur collective de type eau/eau ou eau glycolée/eau.", version: "Version A81, en vigueur depuis le 30/04/2026", pdf: "https://calculateur-cee.ademe.fr/pdf/display/367/BAR-TH-180", link: {href: "/expertises/pompe-a-chaleur/residentiel/", label: "PAC collective eau/eau"}},
      {code: "BAR-TH-169", title: "Pompe à chaleur collective de type air/eau ou eau/eau pour l’eau chaude sanitaire", description: "Pompe à chaleur collective dédiée à l'eau chaude sanitaire.", version: "Version A65-2, en vigueur depuis le 01/04/2025", pdf: "https://calculateur-cee.ademe.fr/pdf/display/310/BAR-TH-169"},
      {code: "BAR-TH-165", title: "Chaudière biomasse collective", description: "Chaudière biomasse collective.", version: "Version A34", pdf: "https://calculateur-cee.ademe.fr/pdf/display/244/BAR-TH-165"},
      {code: "BAR-TH-137", title: "Raccordement d’un bâtiment résidentiel à un réseau de chaleur", description: "Raccordement d'un bâtiment résidentiel à un réseau de chaleur.", version: "Version A79-4, en vigueur depuis le 01/01/2026", pdf: "https://calculateur-cee.ademe.fr/pdf/display/308/BAR-TH-137"},
      {code: "BAR-TH-123", title: "Optimiseur de relance en chauffage collectif", description: "Optimiseur de relance en chauffage collectif.", version: "Version A54, en vigueur depuis le 01/01/2024", pdf: "https://calculateur-cee.ademe.fr/pdf/display/142/BAR-TH-123"},
      {code: "BAR-TH-110", title: "Radiateur basse température pour un chauffage central", description: "Radiateurs basse température sur un chauffage central.", version: "Version A16", pdf: "https://calculateur-cee.ademe.fr/pdf/display/115/BAR-TH-110"},
      {code: "BAR-TH-117", title: "Robinet thermostatique", description: "Robinets thermostatiques sur les émetteurs de chauffage.", version: "Version A14", pdf: "https://calculateur-cee.ademe.fr/pdf/display/61/BAR-TH-117"},
      {code: "BAR-TH-161", title: "Isolation de points singuliers d'un réseau", description: "Isolation des points singuliers (vannes, brides) d'un réseau de chauffage ou d'ECS.", version: "Version A71, en vigueur depuis le 01/08/2025", pdf: "https://calculateur-cee.ademe.fr/pdf/display/219/BAR-TH-161"},
      {code: "RES-CH-104", title: "Réhabilitation d’un poste de livraison de chaleur d’un bâtiment résidentiel", description: "Réhabilitation du poste de livraison de chaleur d'un bâtiment résidentiel raccordé à un réseau.", version: "Version A36, en vigueur depuis le 12/10/2020", pdf: "https://calculateur-cee.ademe.fr/pdf/display/261/RES-CH-104"},
    ],
  },
  {
    title: "Ventilation",
    fiches: [
      {code: "BAR-TH-125", title: "Système de ventilation double flux autoréglable ou modulé à haute performance", description: "Ventilation double flux autoréglable ou modulée à haute performance (France métropolitaine).", version: "Version A54, en vigueur depuis le 01/01/2024", pdf: "https://calculateur-cee.ademe.fr/pdf/display/298/BAR-TH-125", link: {href: "/expertises/vmc-double-flux/prime-cee/", label: "Prime CEE VMC double flux"}},
      {code: "BAR-TH-127", title: "Ventilation Mécanique Contrôlée simple flux hygroréglable", description: "Ventilation mécanique simple flux hygroréglable (France métropolitaine).", version: "Version A58, en vigueur depuis le 01/04/2024", pdf: "https://calculateur-cee.ademe.fr/pdf/display/299/BAR-TH-127"},
    ],
  },
];
---

<ExpertisePage
  title="Fiches CEE secteur résidentiel : opérations éligibles"
  description="Fiches CEE du secteur résidentiel (BAR-) pour l'habitat collectif : intitulé officiel, version en vigueur et texte PDF pour l'isolation, le chauffage collectif et la ventilation."
  canonical="/dispositifs/fiches-cee/residentiel/"
  keyword="Fiches CEE résidentiel"
  cluster="Dispositifs CEE"
  breadcrumb={[{label: "Dispositifs CEE", href: "/dispositifs/"}, {label: "Fiches CEE", href: "/dispositifs/fiches-cee/"}]}
  journeyPages={journeyPages}
  relatedPages={[
    {title: "Pompe à chaleur – résidentiel", href: "/expertises/pompe-a-chaleur/residentiel/", description: "La PAC collective en copropriété génère les primes CEE les plus importantes du secteur résidentiel."},
    {title: "Isolation – résidentiel", href: "/expertises/isolation-thermique/residentiel/", description: "L'isolation des copropriétés (combles, murs, planchers) concentre l'essentiel des opérations CEE en résidentiel collectif."},
    {title: "VMC double flux", href: "/expertises/vmc-double-flux/", description: "La VMC double flux en copropriété est éligible aux CEE — prime cumulable avec l'isolation et la PAC."},
  ]}
>
  <h2>Secteur résidentiel : 17 fiches CEE sélectionnées</h2>

  <p>
    Le secteur résidentiel est codé <strong>BAR-</strong> (bâtiment résidentiel) ; le préfixe <strong>RES-</strong> désigne, lui, les réseaux (chaleur, froid, éclairage extérieur). Nous présentons ci-dessous les fiches les plus utilisées en habitat collectif, classées par grande famille de travaux. Les fiches de chauffage « fossile » ont été abrogées : BAR-TH-106 (chaudière individuelle) le 01/01/2024, BAR-TH-107 (chaudière collective) le 01/01/2025, BAR-TH-150 (PAC collective à absorption) et BAR-TH-167 (chauffe-bain) le 01/09/2025. Chaque fiche définit un forfait de <a href="/dispositifs/kwh-cumac/">kWh cumac</a> selon des critères techniques précis ; cette présentation n'a pas vocation à remplacer le texte officiel de la fiche.
  </p>

  <FicheGrid groups={groups} />

  <div class="expertise-highlight">
    <p>Intitulés et versions repris de la liste officielle des fiches d'opérations standardisées publiée par le ministère de la Transition écologique (consultée en octobre 2026). Les conditions d'éligibilité, la formule de calcul et les pièces justificatives figurent dans le texte officiel de chaque fiche (lien PDF ci-dessus). Pour une étude personnalisée de votre projet, contactez nos experts.</p>
  </div>
</ExpertisePage>
