const description = "Courtier en énergie pour professionnels : stratégie d'achat, lecture de facture, TURPE, accise et taux réduits, appel d'offres, exemple chiffré.";
const h1 = "Courtier en énergie : acheter votre électricité et votre gaz au juste prix";
const pageDates = getPageDates(canonical);

const faq = [
  {
    question: "Quelle part de la facture d'électricité peut-on négocier ?",
    answer: "Seule la fourniture, c'est-à-dire le prix de l'énergie elle-même, se négocie avec le fournisseur. L'acheminement (TURPE) est fixé par la Commission de régulation de l'énergie et les taxes par la loi. Sur ces deux postes, l'entreprise agit au moyen de la puissance contractuelle, de la bonne option tarifaire et des taux réduits auxquels elle a droit.",
  },
  {
    question: "Comment savoir si mon entreprise a droit à un taux réduit d'accise ?",
    answer: "Les tarifs réduits, exonérations et exemptions sont listés aux articles L. 312-42 et suivants du code des impositions sur les biens et services. Pour en bénéficier, l'entreprise remet à son fournisseur une attestation qui précise les usages concernés et les quantités affectées.",
  },
  {
    question: "Faut-il choisir un prix fixe ou un prix indexé ?",
    answer: "Le prix fixe donne de la visibilité sur le budget pendant toute la durée du contrat. Le prix indexé suit le marché, à la hausse comme à la baisse. Le choix dépend de la part de l'énergie dans vos coûts et de votre capacité à suivre les marchés.",
  },
  {
    question: "Un fournisseur peut-il facturer une mauvaise option d'acheminement ?",
    answer: "L'option tarifaire et la puissance contractuelle figurent sur la facture et dans le contrat d'acheminement. Une puissance trop haute coûte chaque mois ; une puissance trop basse entraîne des dépassements. Ces paramètres se vérifient à partir des courbes de charge.",
  },
  {
    question: "L'intervention d'Oteria Conseil sur l'achat d'énergie est-elle payante ?",
    answer: "Non, notre accompagnement est gratuit pour votre entreprise. Nous ne vendons pas d'énergie et n'installons aucun équipement.",
  },
  {
    question: "Pourquoi relier l'achat d'énergie aux CEE ?",
    answer: "Parce que le kWh le moins cher reste celui que l'on ne consomme pas. Une baisse de consommation financée en partie par une prime CEE réduit la facture sur toutes ses composantes proportionnelles, quel que soit le contrat signé.",
  },
];

const schema = [
  { "@context": "https://schema.org", "@type": "WebPage", name: title, description, url: `${siteUrl}${canonical}`, ...(pageDates ? { datePublished: pageDates.published, dateModified: pageDates.modified } : {}) },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: h1,
    description,
    author: { "@type": "Organization", name: "Oteria Conseil", url: siteUrl },
    publisher: { "@type": "Organization", name: "Oteria Conseil", url: siteUrl },
    mainEntityOfPage: `${siteUrl}${canonical}`,
    ...(pageDates ? { datePublished: pageDates.published, dateModified: pageDates.modified } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Accueil", item: `${siteUrl}/` },
      { "@type": "ListItem", position: 2, name: "Nos services", item: `${siteUrl}/services/` },
      { "@type": "ListItem", position: 3, name: "Achat d'énergie et factures", item: `${siteUrl}${canonical}` },
    ],
  },
  { "@context": "https://schema.org", "@type": "ProfessionalService", name: "Oteria Conseil", url: siteUrl, description: "Mandataire CEE : étude des projets, sélection d'installateurs partenaires et sécurisation des dossiers de certificats d'économies d'énergie", areaServed: "FR" },
