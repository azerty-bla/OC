    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    name: "Oteria Conseil",
    url: siteUrl,
    description: "Mandataire CEE : étude des projets, sélection d'installateurs partenaires et sécurisation des dossiers de certificats d'économies d'énergie",
