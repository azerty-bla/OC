  },
  {
    question: "Peut-on demander la prime CEE après avoir signé le devis de GTB ?",
    answer: "Non. La preuve du rôle actif et incitatif doit être antérieure ou égale à la date d'engagement, c'est-à-dire la date d'acceptation du devis. Le cadre CEE se fixe donc avant toute signature.",
  },
];

const schema = [
