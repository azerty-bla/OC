const description = "Décret BACS : bâtiments concernés dès 70 kW, échéance reportée au 1er janvier 2030, classe de GTB exigée et prime CEE BAT-TH-116, avec un exemple chiffré.";
const h1 = "Décret BACS : qui est concerné, quand, et comment financer la GTB";
const pageDates = getPageDates(canonical);

